        function showToast(title, message, icon = 'fa-circle-check', type = 'success') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            
            const colorMap = {
                success: 'border-eco-500 text-eco-600 bg-white',
                info: 'border-aqua-500 text-aqua-600 bg-white',
                warning: 'border-amber-500 text-amber-600 bg-white'
            };

            toast.className = `toast-enter pointer-events-auto flex items-start space-x-3 p-4 rounded-2xl shadow-xl border-l-4 ${colorMap[type] || colorMap.success} border border-slate-100`;
            toast.innerHTML = `
                <div class="text-xl mt-0.5"><i class="fa-solid ${icon}"></i></div>
                <div class="flex-grow pr-2">
                    <h4 class="font-bold text-slate-800 text-xs sm:text-sm">${title}</h4>
                    <p class="text-xs text-slate-500 leading-snug mt-0.5">${message}</p>
                </div>
                <button onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-600 text-xs">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            `;

            container.appendChild(toast);
            setTimeout(() => {
                if (toast.parentElement) toast.remove();
            }, 4500);
        }

        function addPoints(amount, reason) {
            appState.user.points += amount;
            appState.user.xp += amount;
            
            // Check level upgrade
            const levels = [
                { name: 'Water Novice', minXp: 0 },
                { name: 'Water Saver', minXp: 200 },
                { name: 'Water Warrior', minXp: 500 },
                { name: 'Water Guardian', minXp: 900 }
            ];

            let newLevel = appState.user.levelTitle;
            let newIndex = appState.user.levelIndex;

            for (let i = levels.length - 1; i >= 0; i--) {
                if (appState.user.xp >= levels[i].minXp) {
                    newLevel = levels[i].name;
                    newIndex = i;
                    break;
                }
            }

            if (newLevel !== appState.user.levelTitle) {
                appState.user.levelTitle = newLevel;
                appState.user.levelIndex = newIndex;
                showToast('LEVEL UP! 🎉', `You have advanced to ${newLevel}!`, 'fa-trophy', 'warning');
            } else {
                showToast(`+${amount} XP Earned!`, reason, 'fa-coins', 'success');
            }

            // Sync with leaderboard entry
            const userLb = appState.leaderboard.find(item => item.isUser);
            if (userLb) {
                userLb.points = appState.user.points;
                userLb.level = appState.user.levelTitle;
            }

            checkBadgeUnlocks();
            saveState();
            renderAllViews();
        }

        function checkBadgeUnlocks() {
            // b1: First Step (Log 1 meter reading)
            if (appState.meterLogs.length >= 1) unlockBadge('b1');
            // b2: Leak Hunter (Report 1 wastage issue)
            if (appState.reports.length >= 1) unlockBadge('b2');
            // b3: 5-Day Streak
            if (appState.user.streak >= 5) unlockBadge('b3');
            // b4: Efficiency Elite
            const hasLowLog = appState.meterLogs.some(l => l.diff <= 3.0);
            if (hasLowLog) unlockBadge('b4');
            // b5: Hydro Guardian (500 XP)
            if (appState.user.xp >= 500) unlockBadge('b5');
        }

        function unlockBadge(badgeId) {
            const badge = appState.badges.find(b => b.id === badgeId);
            if (badge && !badge.unlocked) {
                badge.unlocked = true;
                showToast('Badge Unlocked! 🏅', `You earned the "${badge.title}" badge!`, 'fa-award', 'warning');
                
