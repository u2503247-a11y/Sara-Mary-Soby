            }

            // Sort by points descending
            filtered.sort((a, b) => b.points - a.points);

            const medalIcons = [
                '<span class="w-6 h-6 rounded-full bg-amber-400 text-white inline-flex items-center justify-center font-bold text-xs shadow-sm"><i class="fa-solid fa-crown text-[10px]"></i></span>',
                '<span class="w-6 h-6 rounded-full bg-slate-300 text-slate-800 inline-flex items-center justify-center font-bold text-xs shadow-sm">2</span>',
                '<span class="w-6 h-6 rounded-full bg-amber-700 text-white inline-flex items-center justify-center font-bold text-xs shadow-sm">3</span>'
            ];

            tbody.innerHTML = filtered.map((item, idx) => `
                <tr class="${item.isUser ? 'bg-aqua-50/80 font-semibold' : 'hover:bg-slate-50'} transition-colors">
                    <td class="px-6 py-3.5">
                        ${idx < 3 ? medalIcons[idx] : `<span class="text-slate-500 font-semibold pl-2">${idx + 1}</span>`}
                    </td>
                    <td class="px-6 py-3.5">
                        <span class="text-slate-900 font-bold">${item.name}</span>
                        ${item.isUser ? '<span class="ml-2 px-2 py-0.5 bg-aqua-600 text-white rounded-md text-[10px]">You</span>' : ''}
                    </td>
                    <td class="px-6 py-3.5 text-slate-600">${item.level}</td>
                    <td class="px-6 py-3.5 font-semibold text-slate-700"><i class="fa-solid fa-award text-amber-500 mr-1"></i>${item.badges} Badges</td>
                    <td class="px-6 py-3.5 text-right font-black text-slate-900">${item.points} <span class="text-slate-400 text-[10px] font-normal">XP</span></td>
                </tr>
            `).join('');
        }

        function renderAllViews() {
            renderMeterTable();
            renderReportsList();
            renderQuests();
            renderBadges();
            renderLeaderboard();
            updateGlobalUI();
        }

        window.onload = function() {
            loadState();
            
            // Default current reading date to today
            const today = new Date().toISOString().split('T')[0];
            const dateInput = document.getElementById('meter-date');
            if (dateInput) dateInput.value = today;

            calculateLiveUsage();
            renderAllViews();
            initChart();
        };
    </script>
</body>
</html>
