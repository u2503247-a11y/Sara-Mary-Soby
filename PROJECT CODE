        function deleteMeterLog(id) {
            appState.meterLogs = appState.meterLogs.filter(l => l.id !== id);
            saveState();
            renderMeterTable();
            updateChartData();
            showToast('Entry Removed', 'Meter log entry was deleted.', 'fa-trash', 'info');
        }

        function clearAllMeterLogs() {
            if (confirm("Clear all meter reading history?")) {
                appState.meterLogs = [];
                saveState();
                renderMeterTable();
                updateChartData();
                showToast('Cleared History', 'All meter entries have been wiped.', 'fa-check', 'info');
            }
        }

        function initChart() {
            const ctx = document.getElementById('consumptionChart');
            if (!ctx) return;

            // Sort logs by date ascending
            const sorted = [...appState.meterLogs].reverse();
            const labels = sorted.map(l => l.date);
            const data = sorted.map(l => l.diff);

            if (consumptionChartInstance) {
                consumptionChartInstance.destroy();
            }

            consumptionChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels.length ? labels : ['No Data'],
                    datasets: [{
                        label: 'Consumption (m³)',
                        data: data.length ? data : [0],
                        borderColor: '#0284c7',
                        backgroundColor: 'rgba(2, 132, 199, 0.12)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#0ea5e9',
                        pointRadius: 5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            padding: 12,
                            titleFont: { size: 12, weight: 'bold' },
                            bodyFont: { size: 12 },
                            callbacks: {
                                label: function(context) {
                                    return ` Usage: ${context.parsed.y} m³ (${(context.parsed.y * 1000).toLocaleString()} Liters)`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9' },
                            ticks: {
                                callback: function(value) { return value + ' m³'; }
                            }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        function updateChartData() {
            if (!consumptionChartInstance) {
                initChart();
                return;
            }
            const sorted = [...appState.meterLogs].reverse();
            consumptionChartInstance.data.labels = sorted.map(l => l.date);
            consumptionChartInstance.data.datasets[0].data = sorted.map(l => l.diff);
            consumptionChartInstance.update();
        }

        function setChartTimeframe(mode) {
            const btnW = document.getElementById('btn-chart-weekly');
            const btnM = document.getElementById('btn-chart-monthly');
            if (mode === 'weekly') {
                btnW.className = 'px-3 py-1 text-xs font-semibold rounded-lg bg-aqua-600 text-white';
                btnM.className = 'px-3 py-1 text-xs font-semibold rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200';
            } else {
                btnM.className = 'px-3 py-1 text-xs font-semibold rounded-lg bg-aqua-600 text-white';
                btnW.className = 'px-3 py-1 text-xs font-semibold rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200';
            }
            updateChartData();
        }


