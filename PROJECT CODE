        function advanceReportStatus(id) {
            const report = appState.reports.find(r => r.id === id);
            if (!report) return;

            const stages = ['Pending', 'Under Review', 'In Progress', 'Resolved'];
            const currentIndex = stages.indexOf(report.status);
            const nextIndex = (currentIndex + 1) % stages.length;

            report.status = stages[nextIndex];

            if (report.status === 'Resolved') {
                addPoints(30, 'Bonus: Reported leak issue resolved by facility!');
            } else {
                saveState();
                renderReportsList();
                showToast('Status Updated', `Report moved to "${report.status}"`, 'fa-info-circle', 'info');
            }
        }


