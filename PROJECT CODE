        function calculateLiveUsage() {
            const prev = parseFloat(document.getElementById('prev-reading').value) || 0;
            const curr = parseFloat(document.getElementById('curr-reading').value) || 0;
            const errorBox = document.getElementById('meter-error');

            if (curr < prev) {
                errorBox.classList.remove('hidden');
            } else {
                errorBox.classList.add('hidden');
            }

            const diff = Math.max(0, curr - prev);
            const liters = Math.round(diff * 1000);
            const daily = Math.round(liters / 7);

            document.getElementById('calc-diff').innerText = `${diff.toFixed(2)} m³`;
            document.getElementById('calc-liters').innerText = `${liters.toLocaleString()} Liters`;
            document.getElementById('calc-daily').innerText = `~${daily} L / day`;
        }

        function handleMeterSubmit(e) {
            e.preventDefault();
            const tag = document.getElementById('meter-tag').value.trim();
            const prev = parseFloat(document.getElementById('prev-reading').value);
            const curr = parseFloat(document.getElementById('curr-reading').value);
            const date = document.getElementById('meter-date').value;

            if (curr < prev) {
                showToast('Validation Error', 'Current reading cannot be lower than previous reading.', 'fa-circle-xmark', 'warning');
                return;
            }

            const diff = parseFloat((curr - prev).toFixed(2));
            const liters = Math.round(diff * 1000);

            const newEntry = {
                id: 'm_' + Date.now(),
                date: date,
                tag: tag,
                prev: prev,
                curr: curr,
                diff: diff,
                liters: liters
            };

            appState.meterLogs.unshift(newEntry);
            
            // Auto update previous reading input for next time
            document.getElementById('prev-reading').value = curr.toFixed(2);
            document.getElementById('curr-reading').value = (curr + 2.50).toFixed(2);
            calculateLiveUsage();

            // Update quest progress
            const q1 = appState.quests.find(q => q.id === 'q1');
            if (q1) q1.current = Math.min(q1.target, q1.current + 1);

            addPoints(25, 'Logged water meter reading');
            renderMeterTable();
            updateChartData();
        }

        function renderMeterTable() {
            const tbody = document.getElementById('meter-table-body');
            const search = document.getElementById('table-search').value.toLowerCase();
            
            const filtered = appState.meterLogs.filter(log => log.tag.toLowerCase().includes(search));

            if (filtered.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="7" class="px-6 py-8 text-center text-slate-400">
                            No meter logs found matching your criteria.
                        </td>
                    </tr>
                `;
                return;
            }

            tbody.innerHTML = filtered.map(log => `
                <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-6 py-3.5 font-medium text-slate-800">${log.date}</td>
                    <td class="px-6 py-3.5">${log.tag}</td>
                    <td class="px-6 py-3.5 font-mono">${log.prev.toFixed(2)}</td>
                    <td class="px-6 py-3.5 font-mono">${log.curr.toFixed(2)}</td>
                    <td class="px-6 py-3.5 font-bold text-aqua-700 font-mono">+${log.diff.toFixed(2)}</td>
                    <td class="px-6 py-3.5 font-semibold text-slate-700">${log.liters.toLocaleString()} L</td>
                    <td class="px-6 py-3.5 text-right">
                        <button onclick="deleteMeterLog('${log.id}')" class="text-slate-400 hover:text-red-600 transition-colors">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </td>
                </tr>
