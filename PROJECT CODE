                    appState = JSON.parse(saved);
                } catch (e) {
                    appState = JSON.parse(JSON.stringify(DEFAULT_STATE));
                }
            } else {
                appState = JSON.parse(JSON.stringify(DEFAULT_STATE));
                saveState();
            }
        }

        function saveState() {
            localStorage.setItem('aquatrack_state', JSON.stringify(appState));
