                        btn.classList.remove('bg-aqua-50', 'text-aqua-600');
                        btn.classList.add('text-slate-600');
                    }
                }
            });

            // Re-render chart if switching to dashboard
            if (tabId === 'dashboard') {
                setTimeout(() => {
                    if (consumptionChartInstance) {
                        consumptionChartInstance.resize();
