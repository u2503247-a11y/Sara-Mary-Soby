<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AquaTrack | Gamified Water Conservation Portal (SDG 6)</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        aqua: {
                            50: '#f0f9ff',
                            100: '#e0f2fe',
                            200: '#bae6fd',
                            300: '#7dd3fc',
                            400: '#38bdf8',
                            500: '#0ea5e9',
                            600: '#0284c7',
                            700: '#0369a1',
                            800: '#075985',
                            900: '#0c4a6e',
                        },
                        eco: {
                            50: '#ecfdf5',
                            100: '#d1fae5',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                        }
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-6px)' },
                        },
                        pulseGlow: {
                            '0%, 100%': { opacity: '1', transform: 'scale(1)' },
                            '50%': { opacity: '0.85', transform: 'scale(1.02)' }
                        }
                    },
                    animation: {
                        float: 'float 3s ease-in-out infinite',
                        pulseGlow: 'pulseGlow 2s infinite',
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        
        .toast-enter {
            animation: slideInRight 0.3s ease-out forwards;
        }
        
        @keyframes slideInRight {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between antialiased selection:bg-aqua-500 selection:text-white">

    <div id="toast-container" class="fixed top-20 right-4 z-50 flex flex-col gap-3 max-w-sm pointer-events-none"></div>

    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Brand Logo -->
                <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('home')">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-aqua-600 to-aqua-400 flex items-center justify-center text-white shadow-md shadow-aqua-500/20">
                        <i class="fa-solid font-bold fa-droplet text-xl animate-float"></i>
                    </div>
                    <div>
                        <span class="text-xl font-bold bg-gradient-to-r from-aqua-700 to-aqua-500 bg-clip-text text-transparent">AquaTrack</span>
                        <span class="hidden sm:inline-block text-xs font-semibold px-2 py-0.5 ml-2 bg-eco-100 text-eco-700 rounded-full border border-eco-500/20">SDG 6 Portal</span>
                    </div>
                </div>

                <!-- Navigation Tabs -->
                <nav class="hidden md:flex space-x-1 lg:space-x-2">
                    <button id="nav-home" onclick="switchTab('home')" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium transition-colors text-aqua-600 bg-aqua-50">
                        <i class="fa-solid fa-house mr-1.5"></i> Overview
                    </button>
                    <button id="nav-dashboard" onclick="switchTab('dashboard')" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-aqua-600 hover:bg-slate-50 transition-colors">
                        <i class="fa-solid fa-chart-line mr-1.5"></i> Dashboard
                    </button>
                    <button id="nav-reports" onclick="switchTab('reports')" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-aqua-600 hover:bg-slate-50 transition-colors">
                        <i class="fa-solid fa-triangle-exclamation mr-1.5"></i> Leak Reporting
                    </button>
                    <button id="nav-gamification" onclick="switchTab('gamification')" class="nav-btn px-3 py-2 rounded-lg text-sm font-medium text-slate-600 hover:text-aqua-600 hover:bg-slate-50 transition-colors">
                        <i class="fa-solid fa-trophy mr-1.5"></i> Leaderboard
                    </button>
                </nav>

                <div class="flex items-center space-x-3">
                    <div class="flex items-center bg-slate-100 rounded-full px-3 py-1.5 border border-slate-200 text-xs sm:text-sm">
                        <div class="flex items-center space-x-1.5 mr-3" title="Total Gamification Points">
                            <i class="fa-solid fa-coins text-amber-500"></i>
                            <span id="nav-user-points" class="font-bold text-slate-800">340</span>
                            <span class="text-slate-400 text-xs">XP</span>
                        </div>
                        <div class="flex items-center space-x-1 border-l border-slate-300 pl-3" title="Current Daily Streak">
                            <i class="fa-solid fa-fire text-orange-500"></i>
                            <span id="nav-user-streak" class="font-bold text-slate-800">5</span>
                            <span class="text-slate-400 text-xs hidden sm:inline">d</span>
                        </div>
                    </div>
                    
                    <!-- Mobile Hamburger Toggle Button -->
                    <button onclick="toggleMobileMenu()" class="md:hidden p-2 rounded-lg text-slate-600 hover:bg-slate-100 focus:outline-none">
                        <i class="fa-solid fa-bars text-xl"></i>
                    </button>
                </div>
            </div>
        </div>

        <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-2 pb-4 space-y-1">
            <button onclick="switchTab('home'); toggleMobileMenu();" class="mobile-nav-btn w-full text-left px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:bg-slate-100 flex items-center">
                <i class="fa-solid fa-house w-6 text-aqua-600"></i> Overview
            </button>
            <button onclick="switchTab('dashboard'); toggleMobileMenu();" class="mobile-nav-btn w-full text-left px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:bg-slate-100 flex items-center">
                <i class="fa-solid fa-chart-line w-6 text-aqua-600"></i> Dashboard & Meter
            </button>
            <button onclick="switchTab('reports'); toggleMobileMenu();" class="mobile-nav-btn w-full text-left px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:bg-slate-100 flex items-center">
                <i class="fa-solid fa-triangle-exclamation w-6 text-aqua-600"></i> Wastage Reporting
            </button>
            <button onclick="switchTab('gamification'); toggleMobileMenu();" class="mobile-nav-btn w-full text-left px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:bg-slate-100 flex items-center">
                <i class="fa-solid fa-trophy w-6 text-aqua-600"></i> Gamification & Leaderboard
            </button>
        </div>
    </header>

    <!-- MAIN CONTENT VIEWS CONTAINER -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- ================================================================= -->
        <!-- VIEW 1: HOME / OVERVIEW SCREEN -->
        <!-- ================================================================= -->
        <section id="view-home" class="space-y-10">
            <!-- Hero Banner -->
            <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900 via-aqua-950 to-aqua-900 text-white p-8 sm:p-12 shadow-xl border border-slate-800">
                <div class="absolute -right-10 -bottom-10 w-80 h-80 bg-aqua-500/20 rounded-full blur-3xl pointer-events-none"></div>
                <div class="absolute right-1/3 -top-10 w-60 h-60 bg-eco-500/10 rounded-full blur-2xl pointer-events-none"></div>

                <div class="relative z-10 max-w-3xl space-y-6">
                    <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-xs font-semibold text-aqua-200">
                        <i class="fa-solid fa-earth-americas text-eco-400"></i>
                        <span>United Nations SDG 6: Clean Water and Sanitation</span>
                    </div>

                    <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-tight">
                        Transform Water Monitoring Into <span class="bg-gradient-to-r from-aqua-300 to-eco-400 bg-clip-text text-transparent">Actionable Impact</span>
                    </h1>

                    <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
                        Every drop counts. AquaTrack empowers students, facilities, and communities to track water usage, report leaks instantly, and earn points while conserving earth's most vital resource.
                    </p>

                    <div class="flex flex-wrap gap-4 pt-2">
                        <button onclick="switchTab('dashboard')" class="px-6 py-3 rounded-xl bg-aqua-500 hover:bg-aqua-400 text-white font-semibold shadow-lg shadow-aqua-500/30 transition-all flex items-center space-x-2 transform hover:-translate-y-0.5">
                            <i class="fa-solid fa-gauge-high"></i>
                            <span>Log Meter Reading</span>
                        </button>
                        <button onclick="switchTab('reports')" class="px-6 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white font-semibold backdrop-blur-md border border-white/20 transition-all flex items-center space-x-2 transform hover:-translate-y-0.5">
                            <i class="fa-solid fa-flag"></i>
                            <span>Report a Leak (+50 XP)</span>
                        </button>
                    </div>
                </div>

                <!-- Live Community Impact Counters -->
                <div class="mt-10 pt-8 border-t border-slate-800 grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
                    <div class="bg-white/5 rounded-2xl p-4 backdrop-blur-sm border border-white/5">
                        <div id="stat-total-saved" class="text-2xl sm:text-3xl font-black text-aqua-300">14,250 L</div>
                        <div class="text-xs text-slate-400 font-medium mt-1">Water Conserved</div>
                    </div>
                    <div class="bg-white/5 rounded-2xl p-4 backdrop-blur-sm border border-white/5">
                        <div id="stat-active-monitors" class="text-2xl sm:text-3xl font-black text-eco-400">328</div>
                        <div class="text-xs text-slate-400 font-medium mt-1">Active Campus Monitors</div>
                    </div>
                    <div class="bg-white/5 rounded-2xl p-4 backdrop-blur-sm border border-white/5">
                        <div id="stat-resolved-leaks" class="text-2xl sm:text-3xl font-black text-amber-400">48</div>
                        <div class="text-xs text-slate-400 font-medium mt-1">Leaks Repaired</div>
                    </div>
                    <div class="bg-white/5 rounded-2xl p-4 backdrop-blur-sm border border-white/5">
                        <div id="stat-efficiency-rate" class="text-2xl sm:text-3xl font-black text-indigo-300">89%</div>
                        <div class="text-xs text-slate-400 font-medium mt-1">Conservation Efficiency</div>
                    </div>
                </div>
            </div>

            <!-- Problem & Target Users Section -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- Environmental Challenge Card -->
                <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-slate-200 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-red-100 text-red-600 flex items-center justify-center text-xl mb-4">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>
                        <h2 class="text-2xl font-bold text-slate-800 mb-3">The Problem: Water Wastage</h2>
                        <p class="text-slate-600 leading-relaxed mb-4">
                            Institutional campuses and residential complexes lose up to <span class="font-semibold text-red-600">30% of supplied water</span> due to unmonitored pipe fractures, running flush tanks, overflowing overhead reservoirs, and lack of individual usage accountability.
                        </p>
                        <ul class="space-y-2 text-sm text-slate-600">
                            <li class="flex items-start">
                                <i class="fa-solid fa-circle-xmark text-red-500 mt-1 mr-2"></i>
                                <span><strong>Delayed Leak Identification:</strong> Minor dripping taps waste 15+ liters per day when unreported.</span>
                            </li>
                            <li class="flex items-start">
                                <i class="fa-solid fa-circle-xmark text-red-500 mt-1 mr-2"></i>
                                <span><strong>Zero Feedback Loop:</strong> Residents remain unaware of their daily volumetric consumption.</span>
                            </li>
                            <li class="flex items-start">
                                <i class="fa-solid fa-circle-xmark text-red-500 mt-1 mr-2"></i>
                                <span><strong>Lack of Incentive:</strong> No rewards for adopting water-wise habits.</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Target Users Breakdown -->
                <div class="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-slate-200 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-aqua-100 text-aqua-600 flex items-center justify-center text-xl mb-4">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <h2 class="text-2xl font-bold text-slate-800 mb-3">Who Is This Built For?</h2>
                        <div class="space-y-4">
                            <div class="flex items-start space-x-3 p-3 rounded-xl bg-slate-50 border border-slate-100">
                                <div class="p-2 bg-aqua-500 text-white rounded-lg text-sm"><i class="fa-solid fa-graduation-cap"></i></div>
                                <div>
                                    <h3 class="font-semibold text-slate-800 text-sm">College Students & Dorm Residents</h3>
                                    <p class="text-xs text-slate-500">Monitor room water meters, log readings, compete in dorm leaderboards.</p>
                                </div>
                            </div>
                            <div class="flex items-start space-x-3 p-3 rounded-xl bg-slate-50 border border-slate-100">
                                <div class="p-2 bg-eco-500 text-white rounded-lg text-sm"><i class="fa-solid fa-building-user"></i></div>
                                <div>
                                    <h3 class="font-semibold text-slate-800 text-sm">Facility Managers & Plumbing Teams</h3>
                                    <p class="text-xs text-slate-500">Receive real-time geotagged leak reports and prioritize urgent repairs.</p>
                                </div>
                            </div>
                            <div class="flex items-start space-x-3 p-3 rounded-xl bg-slate-50 border border-slate-100">
                                <div class="p-2 bg-indigo-500 text-white rounded-lg text-sm"><i class="fa-solid fa-tree"></i></div>
                                <div>
                                    <h3 class="font-semibold text-slate-800 text-sm">Residential Communities & Eco Clubs</h3>
                                    <p class="text-xs text-slate-500">Promote collective sustainability, track community benchmarks, and earn badges.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gamified Flow Step by Step -->
            <div class="bg-gradient-to-r from-aqua-900 to-slate-900 text-white rounded-3xl p-8 shadow-xl">
                <div class="text-center max-w-2xl mx-auto mb-8">
                    <h2 class="text-2xl sm:text-3xl font-bold">How AquaTrack Gamification Works</h2>
                    <p class="text-slate-300 text-sm mt-2">Empowering individuals through interactive loops of tracking, reporting, and reward badges.</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-4 gap-6 text-center">
                    <div class="p-5 rounded-2xl bg-white/5 border border-white/10 hover:border-aqua-400 transition-colors">
                        <div class="w-12 h-12 mx-auto rounded-full bg-aqua-500 text-white flex items-center justify-center font-bold text-lg mb-3">1</div>
                        <h3 class="font-bold text-base mb-1">Log Readings</h3>
                        <p class="text-xs text-slate-300">Submit periodic meter readings to track consumption trends.</p>
                    </div>
                    <div class="p-5 rounded-2xl bg-white/5 border border-white/10 hover:border-aqua-400 transition-colors">
                        <div class="w-12 h-12 mx-auto rounded-full bg-eco-500 text-white flex items-center justify-center font-bold text-lg mb-3">2</div>
                        <h3 class="font-bold text-base mb-1">Earn Points</h3>
                        <p class="text-xs text-slate-300">Receive +25 XP per meter log and +50 XP for reporting active leaks.</p>
                    </div>
                    <div class="p-5 rounded-2xl bg-white/5 border border-white/10 hover:border-aqua-400 transition-colors">
                        <div class="w-12 h-12 mx-auto rounded-full bg-amber-500 text-white flex items-center justify-center font-bold text-lg mb-3">3</div>
                        <h3 class="font-bold text-base mb-1">Unlock Badges</h3>
                        <p class="text-xs text-slate-300">Build streaks and achieve milestones to collect rare eco-badges.</p>
                    </div>
                    <div class="p-5 rounded-2xl bg-white/5 border border-white/10 hover:border-aqua-400 transition-colors">
                        <div class="w-12 h-12 mx-auto rounded-full bg-indigo-500 text-white flex items-center justify-center font-bold text-lg mb-3">4</div>
                        <h3 class="font-bold text-base mb-1">Climb Ranks</h3>
                        <p class="text-xs text-slate-300">Compete on campus leaderboards to earn the top "Water Guardian" title.</p>
                    </div>
                </div>
            </div>

            <!-- SDG Alignment Cards -->
            <div>
                <div class="flex items-center justify-between mb-6">
                    <div>
                        <h2 class="text-2xl font-bold text-slate-800">Aligned with UN SDG 6 Targets</h2>
                        <p class="text-sm text-slate-500">Supporting global Sustainable Development Goals for clean water access.</p>
                    </div>
                    <a href="https://sdgs.un.org/goals/goal6" target="_blank" class="text-xs font-semibold text-aqua-600 hover:text-aqua-700 flex items-center gap-1">
                        UN SDG 6 Details <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    </a>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center space-x-3 mb-3">
                            <span class="px-2.5 py-1 rounded-lg bg-blue-100 text-blue-800 font-bold text-xs">Target 6.1</span>
                            <h3 class="font-bold text-slate-800 text-sm">Safe Drinking Water</h3>
                        </div>
                        <p class="text-xs text-slate-600 leading-relaxed">Promoting equitable access to safe and affordable drinking water through systematic monitoring and leak prevention.</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center space-x-3 mb-3">
                            <span class="px-2.5 py-1 rounded-lg bg-eco-100 text-eco-800 font-bold text-xs">Target 6.4</span>
                            <h3 class="font-bold text-slate-800 text-sm">Water-Use Efficiency</h3>
                        </div>
                        <p class="text-xs text-slate-600 leading-relaxed">Substantially increasing water-use efficiency across sectors and ensuring sustainable withdrawals to address scarcity.</p>
                    </div>
                    <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow">
                        <div class="flex items-center space-x-3 mb-3">
                            <span class="px-2.5 py-1 rounded-lg bg-amber-100 text-amber-800 font-bold text-xs">Target 6.b</span>
                            <h3 class="font-bold text-slate-800 text-sm">Community Action</h3>
                        </div>
                        <p class="text-xs text-slate-600 leading-relaxed">Supporting and strengthening the participation of local communities in improving water and sanitation management.</p>
                    </div>
                </div>
            </div>
        </section>


        <!-- ================================================================= -->
        <!-- VIEW 2: DASHBOARD & METER READING SCREEN -->
        <!-- ================================================================= -->
        <section id="view-dashboard" class="hidden space-y-8">
            <!-- Top Dashboard Stats Header -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <div class="text-xs font-medium text-slate-500">Current Period Usage</div>
                        <div id="kpi-current-usage" class="text-2xl font-bold text-slate-800 mt-1">10.2 m³</div>
                        <div class="text-xs text-slate-400 mt-0.5">Approx. 10,200 Liters</div>
                    </div>
                    <div class="p-3 bg-aqua-50 text-aqua-600 rounded-xl">
                        <i class="fa-solid fa-faucet-drip text-xl"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <div class="text-xs font-medium text-slate-500">Change vs Last Period</div>
                        <div id="kpi-change-badge" class="inline-flex items-center text-xs font-bold px-2 py-0.5 rounded-full bg-eco-100 text-eco-700 mt-1">
                            <i class="fa-solid fa-arrow-down mr-1"></i> -21.4%
                        </div>
                        <div class="text-xs text-slate-400 mt-0.5">Saved ~2.8 m³</div>
                    </div>
                    <div class="p-3 bg-eco-50 text-eco-600 rounded-xl">
                        <i class="fa-solid fa-arrow-trend-down text-xl"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <div class="text-xs font-medium text-slate-500">Efficiency Grade</div>
                        <div id="kpi-grade" class="text-2xl font-bold text-eco-600 mt-1">Grade A</div>
                        <div class="text-xs text-slate-400 mt-0.5">Optimal Usage Range</div>
                    </div>
                    <div class="p-3 bg-amber-50 text-amber-600 rounded-xl">
                        <i class="fa-solid fa-award text-xl"></i>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <div class="text-xs font-medium text-slate-500">Est. Cost Savings</div>
                        <div id="kpi-savings" class="text-2xl font-bold text-indigo-600 mt-1">$42.50</div>
                        <div class="text-xs text-slate-400 mt-0.5">Based on municipal rates</div>
                    </div>
                    <div class="p-3 bg-indigo-50 text-indigo-600 rounded-xl">
                        <i class="fa-solid fa-piggy-bank text-xl"></i>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <!-- Interactive Meter Log Form -->
                <div class="lg:col-span-5 bg-white rounded-2xl p-6 shadow-sm border border-slate-200">
                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <h2 class="text-lg font-bold text-slate-800">Log Meter Reading</h2>
                            <p class="text-xs text-slate-500">Record cubic meters (m³) from your sub-meter.</p>
                        </div>
                        <span class="px-2.5 py-1 bg-amber-100 text-amber-800 text-xs font-bold rounded-lg">+25 XP Reward</span>
                    </div>

